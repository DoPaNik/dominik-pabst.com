{
  "name": "dominik-pabst.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run build:critical-scripts",
    "dev": "astro dev",
    "prebuild": "npm run build:critical-scripts",
    "build": "astro build",
    "postbuild": "node scripts/inject-csp-hashes.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "build:critical-scripts": "node scripts/build-critical-scripts.mjs",
    "test": "playwright test --project=chromium",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "playwright test --project=visual",
    "generate:portrait": "node scripts/fetch-portrait.mjs",
    "generate:og-fonts": "node scripts/fetch-og-fonts.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.2.10",
    "lucide-static": "^1.39.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "postcss-custom-media": "^12.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "satori": "^0.33.4",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "lint-staged": {
    "*.{ts,astro,mjs,js}": "eslint --fix",
    "src/styles/**/*.css": "stylelint --fix",
    "*.{ts,astro,mjs,js,css,md,json,yml,yaml}": "prettier --write"
  }
}
