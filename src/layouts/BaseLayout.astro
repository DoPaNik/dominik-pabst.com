---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getDictionary } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  lang: Locale;
  current: 'home' | 'about' | 'talks' | 'writing' | 'contact';
  path: string;
  title: string;
  description: string;
  /** Pre-serialized JSON-LD object(s) for this page (Person, SpeakingEvent, ...). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Excludes the page from search indexing (e.g. post-submit thank-you pages). */
  noindex?: boolean;
}

const { lang, current, path, title, description, schema, noindex = false } = Astro.props;
const t = getDictionary(lang);

const canonicalUrl = getAbsoluteLocaleUrl(lang, path);
const alternateDe = getAbsoluteLocaleUrl('de', path);
const alternateEn = getAbsoluteLocaleUrl('en', path);
const ogImage = new URL(site.photo, site.url).toString();
const ogImageAlt = t.common.portraitAlt;

const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Above-the-fold fonts: nav wordmark / H1 headings (mono 800) and body copy (Roboto 400) -->
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-800-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/roboto-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href={alternateDe} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateDe} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="840" />
    <meta property="og:image:height" content="1050" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:site_name" content="Dominik Pabst" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      schemaList.map((entry) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
      ))
    }

    <script is:inline>
      (function () {
        function applyStoredTheme() {
          try {
            const stored = localStorage.getItem('dpn-theme');
            if (stored === 'light') document.documentElement.setAttribute('data-theme', 'light');
            else document.documentElement.removeAttribute('data-theme');
          } catch {
            // localStorage may be unavailable (e.g. private browsing) — keep the default theme.
          }
        }
        applyStoredTheme();
        // ClientRouter swaps <html> attributes on navigation — re-apply the theme.
        document.addEventListener('astro:after-swap', applyStoredTheme);
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">{t.common.skipToContent}</a>
    <Nav lang={lang} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
