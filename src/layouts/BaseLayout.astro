---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getDictionary } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  lang: Locale;
  current: 'home' | 'about' | 'talks' | 'writing' | 'contact';
  path: string;
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Pre-serialized JSON-LD object(s) for this page (Person, SpeakingEvent, ...). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Excludes the page from search indexing (e.g. post-submit thank-you pages). */
  noindex?: boolean;
}

const {
  lang,
  current,
  path,
  title,
  description,
  ogImage = '/og/dopanik.png',
  ogImageAlt,
  schema,
  noindex = false,
} = Astro.props;
const t = getDictionary(lang);

const canonicalUrl = getAbsoluteLocaleUrl(lang, path);
const alternateDe = getAbsoluteLocaleUrl('de', path);
const alternateEn = getAbsoluteLocaleUrl('en', path);
const resolvedOgImage = new URL(ogImage, site.url).toString();
const resolvedOgImageAlt = ogImageAlt ?? t.common.socialCardAlt;

const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const rssHref = lang === 'de' ? '/rss.xml' : '/en/rss.xml';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Above-the-fold fonts: nav wordmark / H1 headings (mono 800) and body copy (Roboto 400) -->
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-800-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/roboto-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href={alternateDe} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateDe} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <link rel="alternate" type="application/rss+xml" title={t.writing.seoTitle} href={rssHref} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="840" />
    <meta property="og:image:height" content="1050" />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:site_name" content="Dominik Pabst" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    {
      schemaList.map((entry) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(entry).replace(/</g, '\\u003c')}
        />
      ))
    }

    <script is:inline src="/scripts/theme-bootstrap.js"></script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">{t.common.skipToContent}</a>
    <Nav lang={lang} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
