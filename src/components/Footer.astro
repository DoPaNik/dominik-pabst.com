---
import { site } from '../data/site';
import { getDictionary } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const year = new Date().getFullYear();
---

<footer class="dpn-footer">
  <div class="dpn-footer__bar">
    <span class="dpn-footer__wordmark">
      <span class="dpn-footer__wordmark-strong">Do</span><span class="dpn-footer__wordmark-brand">Pa</span><span class="dpn-footer__wordmark-strong">Nik</span>
    </span>
    <span class="dpn-footer__meta">© {year} {site.name} · dopanik.de</span>

    <ul class="dpn-footer__socials">
      {
        site.socials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noreferrer">
              {social.name}
            </a>
          </li>
        ))
      }
    </ul>

    <span class="dpn-footer__spacer" />
    <span class="dpn-footer__tagline">{t.common.footerTagline}</span>
  </div>
</footer>

<style>
  .dpn-footer {
    border-top: 1px solid var(--border);
    padding: var(--space-10) 0;
    margin-top: var(--space-6);
  }
  .dpn-footer__bar {
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .dpn-footer__wordmark {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 16px;
  }
  .dpn-footer__wordmark-strong { color: var(--text-strong); }
  .dpn-footer__wordmark-brand { color: var(--brand); }
  .dpn-footer__meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
  }
  .dpn-footer__socials {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dpn-footer__socials a {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    text-decoration: none;
  }
  .dpn-footer__socials a:hover {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .dpn-footer__spacer {
    flex: 1;
  }
  .dpn-footer__tagline {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
  }
</style>
