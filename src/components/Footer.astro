---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site } from '../data/site';
import { getDictionary } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import '../styles/components/footer.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const year = new Date().getFullYear();
const buildCommit = import.meta.env.PUBLIC_BUILD_COMMIT;
const buildTime = import.meta.env.PUBLIC_BUILD_TIME as string;
const buildTimeLabel = buildTime?.slice(0, 16).replace('T', ' ');
const legalLinks = [
  { label: t.common.footerLegal.imprint, path: 'impressum' },
  { label: t.common.footerLegal.privacy, path: 'datenschutz' },
];
---

<footer class="dpn-footer">
  <div class="dpn-footer__bar">
    <span class="dpn-footer__wordmark">
      <span class="dpn-footer__wordmark-strong">Do</span><span class="dpn-footer__wordmark-brand"
        >Pa</span
      ><span class="dpn-footer__wordmark-strong">Nik</span>
    </span>
    <span class="dpn-footer__meta">© {year} {site.name} · dopanik.de</span>

    <a
      class="dpn-footer__build"
      href={`https://github.com/dopanik/dominik-pabst.com/commit/${buildCommit}`}
      target="_blank"
      rel="noreferrer"
      title={`deployed ${buildTimeLabel} UTC`}
    >
      build {buildCommit}
    </a>

    <ul class="dpn-footer__socials">
      {
        site.socials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noreferrer">
              {social.name}
            </a>
          </li>
        ))
      }
    </ul>

    <span class="dpn-footer__spacer"></span>
    <span class="dpn-footer__tagline">{t.common.footerTagline}</span>

    <ul class="dpn-footer__legal">
      {
        legalLinks.map((link) => (
          <li>
            <a href={getRelativeLocaleUrl(lang, link.path)}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
