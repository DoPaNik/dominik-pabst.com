---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../astro/Button.astro';
import MatrixRainBackdrop from '../astro/MatrixRainBackdrop.astro';
import RoleRotator from '../astro/RoleRotator.astro';
import TerminalWindow from '../astro/TerminalWindow.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';
import { buildPersonSchema } from '../../lib/schema';
import '../../styles/pages/home.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const h = t.home;

const talksHref = getRelativeLocaleUrl(lang, 'talks');
const contactHref = getRelativeLocaleUrl(lang, 'contact');
---

<BaseLayout
  lang={lang}
  current="home"
  path=""
  title={h.seoTitle}
  description={h.seoDescription}
  schema={buildPersonSchema(lang)}
>
  <header class="dpn-hero">
    <div class="dpn-hero__grid-bg" aria-hidden="true"></div>
    <div class="dpn-hero__rain" aria-hidden="true">
      <MatrixRainBackdrop />
    </div>
    <div class="dpn-hero__inner">
      <div class="dpn-hero__copy">
        <p class="dpn-hero__prompt">
          <span class="dpn-hero__prompt-brand">dominik@dopanik</span>:~$ whoami
        </p>
        <h1 class="dpn-hero__heading">
          {h.headingLine1}<br />{h.headingLine2}
        </h1>
        <p class="dpn-hero__role">
          <span class="dpn-hero__role-prefix">{h.rolePrefix}</span>
          <span class="dpn-hero__role-value"><RoleRotator roles={[...h.roles]} /></span>
        </p>
        <p class="dpn-hero__intro">{h.intro}</p>
        <div class="dpn-hero__actions">
          <Button href={talksHref} variant="primary" prompt size="lg">{h.ctaPrimary}</Button>
          <Button href={contactHref} variant="ghost" size="lg">{h.ctaSecondary}</Button>
        </div>
      </div>

      <div class="dpn-hero__art">
        <TerminalWindow title={h.pipeline.title} class="dpn-hero__term">
          <p class="dpn-pipeline__cmd">
            <span class="dpn-pipeline__prompt" aria-hidden="true">$</span>{' '}
            {h.pipeline.command}
          </p>
          <ul class="dpn-pipeline__steps">
            {
              h.pipeline.steps.map((step) => (
                <li class="dpn-pipeline__step">
                  <span class="dpn-pipeline__check" aria-hidden="true">
                    ✓
                  </span>
                  <span class="dpn-pipeline__label">{step.label}</span>
                  <span class="dpn-pipeline__meta">{step.meta}</span>
                </li>
              ))
            }
          </ul>
          <p class="dpn-pipeline__gate">
            <span class="dpn-pipeline__gate-dot" aria-hidden="true"></span>
            <span class="dpn-pipeline__arrow" aria-hidden="true"> → </span>
            {h.pipeline.gateLabel}
            <span class="dpn-pipeline__gate-state">{h.pipeline.gateState}</span>
          </p>
        </TerminalWindow>
      </div>
    </div>
  </header>
</BaseLayout>
