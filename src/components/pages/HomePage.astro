---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../astro/Button.astro';
import MatrixRainBackdrop from '../astro/MatrixRainBackdrop.astro';
import RoleRotator from '../astro/RoleRotator.astro';
import TerminalWindow from '../astro/TerminalWindow.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';
import { buildPersonSchema } from '../../lib/schema';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const h = t.home;

const talksHref = getRelativeLocaleUrl(lang, 'talks');
const contactHref = getRelativeLocaleUrl(lang, 'contact');
---

<BaseLayout
  lang={lang}
  current="home"
  path=""
  title={h.seoTitle}
  description={h.seoDescription}
  schema={buildPersonSchema(lang)}
>
  <header class="dpn-hero">
    <div class="dpn-hero__grid-bg" aria-hidden="true"></div>
    <div class="dpn-hero__rain" aria-hidden="true">
      <MatrixRainBackdrop opacity={0.08} />
    </div>
    <div class="dpn-hero__inner">
      <div class="dpn-hero__copy">
        <p class="dpn-hero__prompt">
          <span class="dpn-hero__prompt-brand">dominik@dopanik</span>:~$ whoami
        </p>
        <h1 class="dpn-hero__heading">
          {h.headingLine1}<br />{h.headingLine2}
        </h1>
        <p class="dpn-hero__role">
          <span class="dpn-hero__role-prefix">{h.rolePrefix}</span>
          <span class="dpn-hero__role-value"><RoleRotator roles={[...h.roles]} /></span>
        </p>
        <p class="dpn-hero__intro">{h.intro}</p>
        <div class="dpn-hero__actions">
          <Button href={talksHref} variant="primary" prompt size="lg">{h.ctaPrimary}</Button>
          <Button href={contactHref} variant="ghost" size="lg">{h.ctaSecondary}</Button>
        </div>
      </div>

      <div class="dpn-hero__art">
        <TerminalWindow title={h.pipeline.title} class="dpn-hero__term">
          <p class="dpn-pipeline__cmd">
            <span class="dpn-pipeline__prompt" aria-hidden="true">$</span>{' '}
            {h.pipeline.command}
          </p>
          <ul class="dpn-pipeline__steps">
            {
              h.pipeline.steps.map((step) => (
                <li class="dpn-pipeline__step">
                  <span class="dpn-pipeline__check" aria-hidden="true">
                    ✓
                  </span>
                  <span class="dpn-pipeline__label">{step.label}</span>
                  <span class="dpn-pipeline__meta">{step.meta}</span>
                </li>
              ))
            }
          </ul>
          <p class="dpn-pipeline__gate">
            <span class="dpn-pipeline__gate-dot" aria-hidden="true"></span>
            <span class="dpn-pipeline__arrow" aria-hidden="true"> → </span>
            {h.pipeline.gateLabel}
            <span class="dpn-pipeline__gate-state">{h.pipeline.gateState}</span>
          </p>
        </TerminalWindow>
        <div class="dpn-hero__pill dpn-hero__pill--amber">{h.statusUptime}</div>
        <div class="dpn-hero__pill dpn-hero__pill--brand">
          <span class="dpn-hero__pill-dot" aria-hidden="true"></span>{h.statusDeploy}
        </div>
      </div>
    </div>
  </header>
</BaseLayout>

<style>
  .dpn-hero {
    position: relative;
    overflow: hidden;
  }
  .dpn-hero__grid-bg {
    position: absolute;
    inset: 0;
    opacity: 0.6;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(120% 80% at 70% 0%, #000 30%, transparent 75%);
  }
  .dpn-hero__rain {
    position: absolute;
    inset: 0;
  }
  .dpn-hero__inner {
    position: relative;
    max-width: var(--container-xl);
    margin: 0 auto;
    padding: 72px var(--gutter) 88px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-12);
    align-items: center;
  }
  .dpn-hero__prompt {
    font-family: var(--font-mono);
    color: var(--text-dim);
    font-size: 13px;
    margin: 0 0 22px;
  }
  .dpn-hero__prompt-brand {
    color: var(--brand);
  }
  .dpn-hero__heading {
    font-size: var(--text-6xl);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    color: var(--text-strong);
  }
  .dpn-hero__role {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    color: var(--text-muted);
    min-height: 38px;
    margin: 0 0 26px;
  }
  .dpn-hero__role-prefix {
    color: var(--text-faint);
  }
  .dpn-hero__role-value {
    color: var(--brand);
  }
  .dpn-hero__intro {
    font-family: var(--font-body);
    color: var(--text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
    max-width: 46ch;
    margin: 0 0 30px;
  }
  .dpn-hero__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .dpn-hero__art {
    position: relative;
  }
  .dpn-hero__term {
    box-shadow: var(--shadow-lg);
  }
  .dpn-pipeline__cmd {
    margin: 0 0 14px;
    color: var(--text-dim);
    white-space: nowrap;
    overflow-x: auto;
  }
  .dpn-pipeline__prompt {
    color: var(--brand);
  }
  .dpn-pipeline__steps {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .dpn-pipeline__step {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .dpn-pipeline__check {
    color: var(--brand);
    flex-shrink: 0;
  }
  .dpn-pipeline__label {
    color: var(--text);
  }
  .dpn-pipeline__meta {
    margin-left: auto;
    color: var(--text-dim);
    padding-left: 12px;
  }
  .dpn-pipeline__gate {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding-top: 14px;
    border-top: 1px dashed var(--border);
    color: var(--text);
  }
  .dpn-pipeline__gate-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--brand);
    flex-shrink: 0;
  }
  .dpn-pipeline__arrow {
    color: var(--text-dim);
  }
  .dpn-pipeline__gate-state {
    margin-left: auto;
    font-weight: 700;
    color: var(--text-strong);
  }
  .dpn-hero__pill {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    background: var(--surface-overlay);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    box-shadow: var(--shadow-md);
  }
  .dpn-hero__pill--amber {
    top: -14px;
    right: 20px;
    color: var(--amber-500);
  }
  .dpn-hero__pill--brand {
    bottom: -14px;
    left: 20px;
    color: var(--brand);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .dpn-hero__pill-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--brand);
  }

  @media (max-width: 880px) {
    .dpn-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
