---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Illustration from '../astro/Illustration.astro';
import Input from '../astro/Input.astro';
import Button from '../astro/Button.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';
import { site } from '../../data/site';
import '../../styles/pages/contact.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const c = t.contact;
const successHref = getRelativeLocaleUrl(lang, 'contact/success');
---

<BaseLayout
  lang={lang}
  current="contact"
  path="contact"
  title={c.seoTitle}
  description={c.seoDescription}
>
  <section class="dpn-section">
    <div class="dpn-section__inner dpn-contact__grid">
      <div class="dpn-contact__form-frame">
        <header class="dpn-section__header">
          <div class="dpn-eyebrow"><span class="dpn-eyebrow__rule"></span>{c.eyebrow}</div>
          <h1 class="dpn-section__title">{c.title}</h1>
          <p class="dpn-section__intro">{c.intro}</p>
        </header>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action={successHref}
          class="dpn-contact__form"
          data-astro-reload
        >
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="language" value={lang} />
          <p class="visually-hidden">
            <label>
              Don't fill this out: <input name="bot-field" />
            </label>
          </p>

          <div class="dpn-contact__row">
            <Input
              label={c.formNameLabel}
              name="name"
              placeholder={c.formNamePlaceholder}
              required
            />
            <Input
              label={c.formEmailLabel}
              name="email"
              type="email"
              placeholder={c.formEmailPlaceholder}
              required
            />
          </div>
          <Input
            label={c.formMessageLabel}
            name="message"
            textarea
            placeholder={c.formMessagePlaceholder}
            required
          />
          <Button type="submit" variant="primary" prompt size="lg">{c.submitLabel}</Button>
        </form>
      </div>

      <div class="dpn-contact__side">
        <div class="dpn-contact__illustration">
          <Illustration name="chat" tone="amber" decorative />
        </div>
        <a href={`mailto:${site.email}`} class="dpn-contact__email">{site.email}</a>
        <p class="dpn-contact__based">{c.basedIn}</p>
        <p class="dpn-contact__socials-intro">{c.socialsIntro}</p>
        <div class="dpn-contact__socials">
          {
            site.socials.map((social) => (
              <a href={social.url} target="_blank" rel="noreferrer" class="dpn-contact__social">
                {social.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
