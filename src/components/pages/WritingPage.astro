---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../astro/Card.astro';
import Badge from '../astro/Badge.astro';
import Button from '../astro/Button.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const w = t.writing;

const allWriting = await getCollection('writing', ({ data }) => data.lang === lang);
const writing = allWriting.sort((a, b) => Number(a.data.placeholder) - Number(b.data.placeholder));
---

<BaseLayout lang={lang} current="writing" path="writing" title={`${w.title} — Dominik Pabst`} description={w.intro}>
  <section class="dpn-section">
    <div class="dpn-section__inner">
      <header class="dpn-section__header">
        <div class="dpn-eyebrow"><span class="dpn-eyebrow__rule"></span>{w.eyebrow}</div>
        <h1 class="dpn-section__title">{w.title}</h1>
        <p class="dpn-section__intro">{w.intro}</p>
      </header>

      <div class="dpn-writing__list">
        {
          writing.map((article) => (
            <Card>
              <div class="dpn-writing__meta">
                <Badge tone="blue" variant="soft">{article.data.source}</Badge>
              </div>
              <h3 class="dpn-writing__title">{article.data.title}</h3>
              <p class="dpn-writing__description">{article.data.description}</p>
              {article.data.url && !article.data.placeholder && (
                <div class="dpn-writing__link">
                  <Button href={article.data.url} variant="link" target="_blank" rel="noreferrer">
                    {w.readMore}
                  </Button>
                </div>
              )}
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dpn-section {
    padding: 88px 0;
  }
  .dpn-section__inner {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .dpn-section__header {
    margin-bottom: 36px;
  }
  .dpn-eyebrow {
    font-family: var(--font-mono);
    color: var(--brand);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .dpn-eyebrow__rule {
    width: 18px;
    height: 1px;
    background: var(--brand);
  }
  .dpn-section__title {
    font-size: var(--text-3xl);
    margin: 0 0 12px;
    color: var(--text-strong);
  }
  .dpn-section__intro {
    color: var(--text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
    max-width: 60ch;
    margin: 0;
  }
  .dpn-writing__list {
    display: grid;
    gap: var(--space-4);
  }
  .dpn-writing__meta {
    margin-bottom: var(--space-3);
  }
  .dpn-writing__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--text-strong);
    margin: 0 0 8px;
  }
  .dpn-writing__description {
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }
  .dpn-writing__link {
    margin-top: var(--space-3);
  }
</style>
