---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../astro/Card.astro';
import Badge from '../astro/Badge.astro';
import Button from '../astro/Button.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const w = t.writing;

const allWriting = await getCollection('writing', ({ data }) => data.lang === lang);
const writing = allWriting.sort((a, b) => {
  if (!a.data.date) return 1;
  if (!b.data.date) return -1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<BaseLayout
  lang={lang}
  current="writing"
  path="writing"
  title={w.seoTitle}
  description={w.seoDescription}
>
  <section class="dpn-section">
    <div class="dpn-section__inner">
      <header class="dpn-section__header">
        <div class="dpn-eyebrow"><span class="dpn-eyebrow__rule"></span>{w.eyebrow}</div>
        <h1 class="dpn-section__title">{w.title}</h1>
        <p class="dpn-section__intro">{w.intro}</p>
      </header>

      <div class="dpn-writing__list">
        {
          writing.map((article) => (
            <Card>
              <div class="dpn-writing__meta">
                <Badge tone="blue" variant="soft">
                  {article.data.source}
                </Badge>
              </div>
              <h3 class="dpn-writing__title">{article.data.title}</h3>
              <p class="dpn-writing__description">{article.data.description}</p>
              {article.data.url && !article.data.placeholder && (
                <div class="dpn-writing__link">
                  <Button href={article.data.url} variant="link" target="_blank" rel="noreferrer">
                    {w.readMore}
                  </Button>
                </div>
              )}
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dpn-writing__list {
    display: grid;
    gap: var(--space-4);
  }
  .dpn-writing__meta {
    margin-bottom: var(--space-3);
  }
  .dpn-writing__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--text-strong);
    margin: 0 0 8px;
  }
  .dpn-writing__description {
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }
  .dpn-writing__link {
    margin-top: var(--space-3);
  }
</style>
