---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerminalWindow from '../astro/TerminalWindow.astro';
import Tag from '../astro/Tag.astro';
import MatrixPortrait from '../astro/MatrixPortrait.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const a = t.about;
const tones = ['brand', 'cyan', 'blue', 'amber', 'magenta', 'neutral'] as const;
const talksHref = getRelativeLocaleUrl(lang, 'talks');
---

<BaseLayout lang={lang} current="about" path="about" title={a.seoTitle} description={a.seoDescription}>
  <section class="dpn-about-hero">
    <div class="dpn-about-hero__bg">
      <MatrixPortrait
        alt="Dominik Pabst — Executive Consultant DevOps & Platform Engineering"
        image="/images/dominik-luma.png"
        align="left"
        parallax
      />
    </div>
    <div class="dpn-about-hero__inner">
      <div class="dpn-about-hero__copy">
        <div class="dpn-about-hero__eyebrow"><span class="dpn-about-hero__eyebrow-rule"></span>{a.eyebrow}</div>
        <h1 class="dpn-about-hero__title">{a.title}</h1>
        <p class="dpn-about-hero__bio">{a.bio}</p>
        <p class="dpn-about-hero__collab">{a.collabLine}</p>
      </div>
    </div>
  </section>

  <section class="dpn-section">
    <div class="dpn-section__inner">
      <header class="dpn-section__header">
        <div class="dpn-eyebrow"><span class="dpn-eyebrow__rule"></span>{a.stackEyebrow}</div>
        <h2 class="dpn-section__title-sm">{a.stackTitle}</h2>
      </header>

      <TerminalWindow title={a.stackTerminalLine}>
        <div class="dpn-about__tags">
          {a.focusAreas.map((focus, i) => (
            <Tag tone={tones[i % tones.length]} href={talksHref}>{focus}</Tag>
          ))}
        </div>
      </TerminalWindow>
    </div>
  </section>
</BaseLayout>

<style>
  .dpn-section {
    padding: 88px 0;
    border-top: 1px solid var(--border-subtle);
  }
  .dpn-section:first-of-type {
    border-top: none;
  }
  .dpn-section__inner {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .dpn-section__header {
    margin-bottom: 36px;
  }
  .dpn-eyebrow {
    font-family: var(--font-mono);
    color: var(--brand);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .dpn-eyebrow__rule {
    width: 18px;
    height: 1px;
    background: var(--brand);
  }
  .dpn-section__title {
    font-size: var(--text-3xl);
    margin: 0;
    color: var(--text-strong);
  }
  .dpn-section__title-sm {
    font-size: var(--text-2xl);
    margin: 0;
    color: var(--text-strong);
  }
  .dpn-about__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .dpn-about-hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    background: var(--ink-950);
    overflow: hidden;
  }
  .dpn-about-hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 130px;
    background: linear-gradient(180deg, transparent, var(--bg));
    pointer-events: none;
    z-index: 1;
  }
  .dpn-about-hero__bg {
    position: absolute;
    inset: 0;
  }
  .dpn-about-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    justify-content: flex-end;
  }
  .dpn-about-hero__copy {
    position: relative;
    max-width: 540px;
    padding: 56px 8px 56px 72px;
  }
  /* Backdrop lives in a pseudo-element so it can dissolve at the hero's bottom
     edge (in sync with the hero fade) without fading the text itself. */
  .dpn-about-hero__copy::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, transparent, var(--ink-950) 42%);
    mask-image: linear-gradient(180deg, #000 calc(100% - 120px), transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 120px), transparent 100%);
  }
  .dpn-about-hero__eyebrow {
    font-family: var(--font-mono);
    color: var(--green-500);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .dpn-about-hero__eyebrow-rule {
    width: 18px;
    height: 1px;
    background: var(--green-500);
  }
  .dpn-about-hero__title {
    font-size: var(--text-3xl);
    margin: 0 0 18px;
    color: var(--ink-050);
    overflow-wrap: break-word;
  }
  .dpn-about-hero__bio {
    font-size: var(--text-lg);
    color: var(--ink-100);
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .dpn-about-hero__collab {
    font-family: var(--font-mono);
    color: var(--green-500);
    font-size: 14px;
    margin: 0;
  }

  @media (max-width: 880px) {
    .dpn-about-hero {
      min-height: 520px;
    }
    .dpn-about-hero__inner {
      justify-content: center;
    }
    .dpn-about-hero::after {
      height: 72px;
    }
    .dpn-about-hero__copy {
      max-width: 100%;
      padding: 24px var(--gutter) 40px;
    }
    .dpn-about-hero__copy::before {
      background: linear-gradient(180deg, rgba(11, 14, 20, 0.6) 0%, var(--ink-950) 55%);
      mask-image: linear-gradient(180deg, #000 calc(100% - 64px), transparent 100%);
      -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 64px), transparent 100%);
    }
  }
</style>
