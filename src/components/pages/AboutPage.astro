---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerminalWindow from '../astro/TerminalWindow.astro';
import Tag from '../astro/Tag.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';
import { site } from '../../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const a = t.about;
const tones = ['brand', 'cyan', 'blue', 'amber', 'magenta', 'neutral'] as const;
const talksHref = getRelativeLocaleUrl(lang, 'talks');
---

<BaseLayout lang={lang} current="about" path="about" title={a.seoTitle} description={a.seoDescription}>
  <section class="dpn-section">
    <div class="dpn-section__inner">
      <header class="dpn-section__header">
        <div class="dpn-eyebrow"><span class="dpn-eyebrow__rule"></span>{a.eyebrow}</div>
        <h1 class="dpn-section__title">{a.title}</h1>
      </header>

      <div class="dpn-about__grid">
        <div class="dpn-about__art">
          <img
            src={site.photo}
            alt="Dominik Pabst — Executive Consultant DevOps & Platform Engineering"
            class="dpn-about__photo"
            width="480"
            height="480"
            loading="lazy"
          />
        </div>
        <div>
          <p class="dpn-about__bio">{a.bio}</p>
          <p class="dpn-about__collab">{a.collabLine}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="dpn-section">
    <div class="dpn-section__inner">
      <header class="dpn-section__header">
        <div class="dpn-eyebrow"><span class="dpn-eyebrow__rule"></span>{a.stackEyebrow}</div>
        <h2 class="dpn-section__title-sm">{a.stackTitle}</h2>
      </header>

      <TerminalWindow title={a.stackTerminalLine}>
        <div class="dpn-about__tags">
          {a.focusAreas.map((focus, i) => (
            <Tag tone={tones[i % tones.length]} href={talksHref}>{focus}</Tag>
          ))}
        </div>
      </TerminalWindow>
    </div>
  </section>
</BaseLayout>

<style>
  .dpn-section {
    padding: 88px 0;
    border-top: 1px solid var(--border-subtle);
  }
  .dpn-section:first-of-type {
    border-top: none;
  }
  .dpn-section__inner {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .dpn-section__header {
    margin-bottom: 36px;
  }
  .dpn-eyebrow {
    font-family: var(--font-mono);
    color: var(--brand);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .dpn-eyebrow__rule {
    width: 18px;
    height: 1px;
    background: var(--brand);
  }
  .dpn-section__title {
    font-size: var(--text-3xl);
    margin: 0;
    color: var(--text-strong);
  }
  .dpn-section__title-sm {
    font-size: var(--text-2xl);
    margin: 0;
    color: var(--text-strong);
  }
  .dpn-about__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-12);
    align-items: center;
  }
  .dpn-about__photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    object-fit: cover;
    border: 1px solid var(--border);
    display: block;
  }
  .dpn-about__bio {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .dpn-about__collab {
    font-family: var(--font-mono);
    color: var(--brand);
    font-size: 14px;
    margin: 0;
  }
  .dpn-about__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 880px) {
    .dpn-about__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
