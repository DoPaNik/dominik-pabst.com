---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerminalWindow from '../astro/TerminalWindow.astro';
import Tag from '../astro/Tag.astro';
import MatrixPortrait from '../astro/MatrixPortrait.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const a = t.about;
const tones = ['brand', 'cyan', 'blue', 'amber', 'magenta', 'neutral'] as const;
const talksHref = getRelativeLocaleUrl(lang, 'talks');
---

<BaseLayout
  lang={lang}
  current="about"
  path="about"
  title={a.seoTitle}
  description={a.seoDescription}
>
  <section class="dpn-about-hero">
    <div class="dpn-about-hero__inner">
      <div class="dpn-about-hero__copy">
        <div class="dpn-eyebrow"><span class="dpn-eyebrow__rule"></span>{a.eyebrow}</div>
        <h1 class="dpn-about-hero__title">{a.title}</h1>
        <p class="dpn-about-hero__bio">{a.bio}</p>
        <p class="dpn-about-hero__collab">{a.collabLine}</p>
      </div>
      <div class="dpn-about-hero__portrait">
        <MatrixPortrait
          src="/images/dominik-portrait.jpg"
          alt={t.common.portraitAlt}
          width={840}
          height={1050}
          caption="~ cat dominik.pixels | decode"
        />
      </div>
    </div>
  </section>

  <section class="dpn-section">
    <div class="dpn-section__inner">
      <header class="dpn-section__header">
        <div class="dpn-eyebrow"><span class="dpn-eyebrow__rule"></span>{a.stackEyebrow}</div>
        <h2 class="dpn-section__title-sm">{a.stackTitle}</h2>
      </header>

      <TerminalWindow title={a.stackTerminalLine}>
        <div class="dpn-about__tags">
          {
            a.focusAreas.map((focus, i) => (
              <Tag tone={tones[i % tones.length]} href={talksHref}>
                {focus}
              </Tag>
            ))
          }
        </div>
      </TerminalWindow>
    </div>
  </section>
</BaseLayout>

<style>
  .dpn-section__title-sm {
    font-size: var(--text-2xl);
    margin: 0;
    color: var(--text-strong);
  }
  .dpn-about__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .dpn-about-hero {
    padding: 88px 0;
  }
  .dpn-about-hero__inner {
    max-width: var(--container-lg);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-12);
    align-items: center;
  }
  .dpn-about-hero__copy {
    max-width: 560px;
  }
  .dpn-about-hero__title {
    font-size: var(--text-3xl);
    margin: 0 0 18px;
    color: var(--text-strong);
    overflow-wrap: break-word;
  }
  .dpn-about-hero__bio {
    font-size: var(--text-lg);
    color: var(--text);
    line-height: 1.7;
    margin: 0 0 18px;
  }
  .dpn-about-hero__collab {
    font-family: var(--font-mono);
    color: var(--brand-deep);
    font-size: 14px;
    margin: 0;
  }
  .dpn-about-hero__portrait {
    justify-self: end;
  }

  @media (--below-tablet) {
    .dpn-about-hero {
      padding: 40px 0 56px;
    }
    .dpn-about-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .dpn-about-hero__portrait {
      justify-self: center;
      max-width: 300px;
      order: -1;
    }
  }
</style>
