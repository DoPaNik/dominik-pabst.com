---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Illustration from '../astro/Illustration.astro';
import TerminalWindow from '../astro/TerminalWindow.astro';
import Tag from '../astro/Tag.astro';
import MatrixPortrait from '../astro/MatrixPortrait.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';
import { site } from '../../data/site';
import '../../styles/pages/about.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const a = t.about;
const tones = ['brand', 'cyan', 'blue', 'amber', 'magenta', 'neutral'] as const;
const talksHref = getRelativeLocaleUrl(lang, 'talks');
---

<BaseLayout
  lang={lang}
  current="about"
  path="about"
  title={a.seoTitle}
  description={a.seoDescription}
  ogImage={site.photo}
  ogImageAlt={t.common.portraitAlt}
>
  <section class="dpn-about-hero">
    <div class="dpn-about-hero__inner">
      <div class="dpn-about-hero__copy">
        <div class="dpn-eyebrow"><span class="dpn-eyebrow__rule"></span>{a.eyebrow}</div>
        <h1 class="dpn-about-hero__title">{a.title}</h1>
        <p class="dpn-about-hero__bio">{a.bio}</p>
        <p class="dpn-about-hero__collab">{a.collabLine}</p>
      </div>
      <div class="dpn-about-hero__portrait">
        <MatrixPortrait
          src="/images/dominik-portrait.jpg"
          alt={t.common.portraitAlt}
          width={840}
          height={1050}
          caption="~ cat dominik.pixels | decode"
        />
      </div>
    </div>
  </section>

  <section class="dpn-section">
    <div class="dpn-section__inner">
      <header class="dpn-section__header">
        <div class="dpn-eyebrow"><span class="dpn-eyebrow__rule"></span>{a.stackEyebrow}</div>
        <h2 class="dpn-section__title-sm">{a.stackTitle}</h2>
      </header>

      <div class="dpn-about__illustration">
        <Illustration name="security" tone="accent" decorative />
      </div>

      <TerminalWindow title={a.stackTerminalLine}>
        <div class="dpn-about__tags">
          {
            a.focusAreas.map((focus, i) => (
              <Tag tone={tones[i % tones.length]} href={talksHref}>
                {focus}
              </Tag>
            ))
          }
        </div>
      </TerminalWindow>
    </div>
  </section>
</BaseLayout>
