---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../astro/Button.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';
import '../../styles/pages/contact-success.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
const c = t.contact;
const homeHref = getRelativeLocaleUrl(lang, '');
---

<BaseLayout
  lang={lang}
  current="contact"
  path="contact/success"
  title={`${c.successTitle} — Dominik Pabst`}
  description={c.successBody}
  noindex
>
  <section class="dpn-success">
    <div class="dpn-success__inner">
      <h1 class="dpn-success__title">{c.successTitle}</h1>
      <p class="dpn-success__body">{c.successBody}</p>
      <Button href={homeHref} variant="ghost">{c.successCta}</Button>
    </div>
  </section>
</BaseLayout>
