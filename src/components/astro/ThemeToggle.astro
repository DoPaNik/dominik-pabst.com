---
import Icon from './Icon.astro';
import '../../styles/components/theme-toggle.css';

interface Props {
  label?: string;
}

const { label = 'Toggle theme' } = Astro.props;
---

<button id="dpn-theme-toggle" class="dpn-iconbtn" type="button" aria-label={label}>
  <span class="dpn-theme-toggle__icon" data-icon="sun">
    <Icon name="sun" size={17} />
  </span>
  <span class="dpn-theme-toggle__icon" data-icon="moon">
    <Icon name="moon" size={17} />
  </span>
</button>

<script is:inline src="/scripts/theme-toggle.js"></script>
