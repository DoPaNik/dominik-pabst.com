---
interface Props {
  src?: string;
  name?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  shape?: 'square' | 'circle';
  ring?: boolean;
  class?: string;
}

const {
  src,
  name = '',
  size = 'md',
  shape = 'square',
  ring = false,
  class: className = '',
} = Astro.props;

function initials(value: string) {
  return value
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((s) => s[0])
    .join('')
    .toUpperCase();
}

const cls = [
  'dpn-avatar',
  shape === 'circle' ? 'dpn-avatar--circle' : '',
  size !== 'md' ? `dpn-avatar--${size}` : '',
  ring ? 'dpn-avatar__ring' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<span class={cls}>
  {src ? <img src={src} alt={name} /> : initials(name) || '~'}
</span>
