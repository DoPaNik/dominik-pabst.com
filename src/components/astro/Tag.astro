---
interface Props {
  tone?: 'brand' | 'amber' | 'blue' | 'magenta' | 'cyan' | 'neutral';
  hash?: boolean;
  href?: string;
  class?: string;
}

const { tone = 'neutral', hash = true, href, class: className = '' } = Astro.props;
const cls = ['dpn-tag', `dpn-tag--tone-${tone}`, className].filter(Boolean).join(' ');
const Tag = href ? 'a' : 'span';
---

<Tag class={cls} href={href}>
  {hash && <span class="dpn-tag__hash">#</span>}
  <slot />
</Tag>
