---
/**
 * Very subtle, slow Matrix rain used as a decorative backdrop — the single
 * matrix accent on pages without the portrait. Sparse columns at low opacity
 * so it reads as texture, not as a feature. Driven by the shared
 * matrix-engine ticker (FPS cap, offscreen/hidden pause). Purely decorative:
 * skipped entirely under prefers-reduced-motion.
 */
import '../../styles/components/matrix-backdrop.css';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class={['dpn-matrix-backdrop', className].filter(Boolean).join(' ')}
  data-matrix-backdrop
  aria-hidden="true"
>
  <canvas data-matrix-backdrop-canvas></canvas>
</div>

<script is:inline type="module" src="/scripts/matrix-backdrop.js"></script>
