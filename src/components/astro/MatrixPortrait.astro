---
/**
 * Framed "decode" portrait — the single matrix signature on the About page.
 *
 * - The real <img> is ALWAYS in the DOM (SEO, a11y, no-JS, reduced-motion).
 * - The canvas sits exactly over the image inside the framed container and
 *   is only activated with JS and without prefers-reduced-motion.
 * - On first visibility a one-time decode animation (~1.8s) dissolves a
 *   glyph field column by column into the sharp photo. Afterwards the
 *   canvas is cleared and unregistered from the ticker — zero idle cost.
 * - Hover/tap re-encodes briefly (≤1s pulse), then back to the photo.
 * - Colors come from CSS custom properties and are read per frame, so a
 *   theme switch mid-animation just works.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  class?: string;
}

const { src, alt, width, height, caption, class: className = '' } = Astro.props;
---

<figure class={['dpn-portrait', className].filter(Boolean).join(' ')} data-matrix-portrait>
  <div class="dpn-portrait__frame">
    <img src={src} alt={alt} width={width} height={height} loading="eager" />
    <canvas data-matrix-portrait-canvas aria-hidden="true"></canvas>
  </div>
  {caption && <figcaption class="dpn-portrait__caption">{caption}</figcaption>}
</figure>

<style>
  .dpn-portrait {
    margin: 0;
    max-width: 420px;
    width: 100%;
  }
  .dpn-portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
  }
  .dpn-portrait__frame img,
  .dpn-portrait__frame canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .dpn-portrait__frame canvas {
    pointer-events: none;
  }
  .dpn-portrait__caption {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
    margin-top: 10px;
  }
</style>

<script>
  import { addMatrixInstance, clampedDpr } from '../../scripts/matrix-engine';

  const GLYPHS = 'アイウエオカキクケコサシスセソタチツテトナニヌネノ01<>/{}$#*+=';
  const CELL = 12; // cell size in CSS px
  const DECODE_MS = 1800;
  const REENCODE_MS = 900;

  function cssVar(name: string, fallback: string): string {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  function themeColors() {
    const light = document.documentElement.getAttribute('data-theme') === 'light';
    return light
      ? {
          // "Ink instead of phosphor": no neon green on paper.
          bg: cssVar('--paper', '#F4F7FA'),
          glyph: cssVar('--green-700', '#1B8B4C'),
          lead: cssVar('--ink-700', '#1E2530'),
          density: 0.7,
        }
      : {
          bg: cssVar('--ink-900', '#0E121A'),
          glyph: cssVar('--green-500', '#37D67A'),
          lead: cssVar('--green-300', '#8CEFB9'),
          density: 1,
        };
  }

  function setupPortrait(root: HTMLElement) {
    if (root.dataset.portraitDone) return;
    root.dataset.portraitDone = 'true';

    const img = root.querySelector<HTMLImageElement>('img');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-matrix-portrait-canvas]');
    if (!img || !canvas) return;

    // Enhancement gate: without motion, only the photo.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      canvas.remove();
      return;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = clampedDpr();
    let cols = 0;
    let rows = 0;
    let cssW = 0;
    let cssH = 0;
    let lum: Float32Array | null = null;
    let colProgress: number[] = [];
    let mode: 'idle' | 'cover' | 'decode' | 'encode' | 'done' = 'idle';
    let modeStart = 0;
    let decodedOnce = false;
    let unregister: (() => void) | null = null;

    function sampleImage() {
      const rect = root.querySelector('.dpn-portrait__frame')!.getBoundingClientRect();
      cssW = rect.width;
      cssH = rect.height;
      canvas!.width = Math.max(1, Math.round(cssW * dpr));
      canvas!.height = Math.max(1, Math.round(cssH * dpr));
      cols = Math.ceil(cssW / CELL);
      rows = Math.ceil(cssH / CELL);

      // Sample the photo into the cell grid → luminance per cell,
      // replicating object-fit: cover.
      const off = document.createElement('canvas');
      off.width = cols;
      off.height = rows;
      const octx = off.getContext('2d', { willReadFrequently: true });
      if (!octx) return;
      const s = Math.max(cols / img!.naturalWidth, rows / img!.naturalHeight);
      const dw = img!.naturalWidth * s;
      const dh = img!.naturalHeight * s;
      octx.drawImage(img!, (cols - dw) / 2, (rows - dh) / 2, dw, dh);
      const data = octx.getImageData(0, 0, cols, rows).data;
      lum = new Float32Array(cols * rows);
      for (let i = 0; i < cols * rows; i++) {
        const r = data[i * 4];
        const g = data[i * 4 + 1];
        const b = data[i * 4 + 2];
        lum[i] = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
      }
      // Columns decode slightly staggered → organic flow.
      colProgress = Array.from({ length: cols }, () => -Math.random() * 0.35);
    }

    function drawGlyphColumn(
      x: number,
      cover: number,
      colors: ReturnType<typeof themeColors>,
      now: number,
      leadRow: number,
    ) {
      for (let y = 0; y < rows; y++) {
        const L = lum![y * cols + x];
        if (L * colors.density < 0.12) continue; // dark cells stay empty
        ctx!.globalAlpha = cover * (0.35 + L * 0.65);
        ctx!.fillStyle = y === leadRow ? colors.lead : colors.glyph;
        ctx!.fillText(
          GLYPHS[(x * 7 + y * 13 + ((now / 90) | 0)) % GLYPHS.length],
          x * CELL,
          y * CELL,
        );
      }
    }

    /** Static fully-encoded frame: opaque background + glyph field. */
    function drawStatic() {
      if (!lum) return;
      const colors = themeColors();
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.fillStyle = colors.bg;
      ctx!.fillRect(0, 0, cssW, cssH);
      ctx!.font = `${CELL}px 'JetBrains Mono', monospace`;
      ctx!.textBaseline = 'top';
      const now = performance.now();
      for (let x = 0; x < cols; x++) drawGlyphColumn(x, 1, colors, now, -1);
      ctx!.globalAlpha = 1;
    }

    function finish() {
      mode = 'done';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.clearRect(0, 0, cssW, cssH);
      if (unregister) {
        unregister();
        unregister = null;
      }
    }

    function drawFrame(now: number) {
      if (!lum || mode === 'idle' || mode === 'cover' || mode === 'done') return;
      const duration = mode === 'decode' ? DECODE_MS : REENCODE_MS;
      const t = Math.min(1, (now - modeStart) / duration);
      const colors = themeColors();

      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.clearRect(0, 0, cssW, cssH);
      ctx!.font = `${CELL}px 'JetBrains Mono', monospace`;
      ctx!.textBaseline = 'top';

      for (let x = 0; x < cols; x++) {
        const p = Math.max(0, Math.min(1, t * 1.35 + colProgress[x]));
        // decode: cover 1→0 (photo appears); encode: short pulse 0→1→0.
        const cover = mode === 'decode' ? 1 - p : Math.sin(p * Math.PI);
        if (cover <= 0.02) continue;

        if (mode === 'decode') {
          // Opaque curtain per column so the photo is revealed, not blended.
          ctx!.globalAlpha = cover;
          ctx!.fillStyle = colors.bg;
          ctx!.fillRect(x * CELL, 0, CELL + 0.5, cssH);
        }

        const leadRow = mode === 'decode' && p > 0 && p < 1 ? Math.floor(p * rows) : -1;
        drawGlyphColumn(x, Math.max(cover, 0.2), colors, now, leadRow);
      }
      ctx!.globalAlpha = 1;

      if (t >= 1) finish();
    }

    function start(nextMode: 'decode' | 'encode') {
      mode = nextMode;
      modeStart = performance.now();
      if (!unregister) {
        unregister = addMatrixInstance({ el: root, draw: drawFrame, fps: 30 });
      }
    }

    function prep() {
      if (!root.isConnected) return;
      sampleImage();
      drawStatic();
      mode = 'cover';
    }

    if (img.complete && img.naturalWidth > 0) prep();
    else img.addEventListener('load', prep, { once: true });

    // One-time decode when the portrait first becomes properly visible.
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting || decodedOnce) return;
        if (mode !== 'cover') return; // wait until sampled
        decodedOnce = true;
        io.disconnect();
        start('decode');
      },
      { threshold: 0.35 },
    );
    io.observe(root);

    // Brief re-encode on hover (desktop) / tap (mobile).
    const reencode = () => {
      if (mode === 'done') start('encode');
    };
    root.addEventListener('pointerenter', reencode);
    root.addEventListener('click', reencode);

    // Theme switch while the static encoded frame is showing → repaint once.
    const themeObserver = new MutationObserver(() => {
      if (!root.isConnected) {
        themeObserver.disconnect();
        return;
      }
      if (mode === 'cover') drawStatic();
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    // Resize: resample grid (debounced). After decode the canvas stays clear.
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      if (!root.isConnected) return;
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        if (mode === 'done' || mode === 'idle') return;
        sampleImage();
        if (mode === 'cover') drawStatic();
      }, 200);
    });
  }

  function initPortraits() {
    document.querySelectorAll<HTMLElement>('[data-matrix-portrait]').forEach(setupPortrait);
  }

  initPortraits();
  document.addEventListener('astro:page-load', initPortraits);
</script>
