---
/**
 * Framed "decode" portrait — the single matrix signature on the About page.
 *
 * - The real <img> is ALWAYS in the DOM (SEO, a11y, no-JS, reduced-motion).
 * - The canvas sits exactly over the image inside the framed container and
 *   is only activated with JS and without prefers-reduced-motion.
 * - On first visibility a one-time decode animation (~1.8s) dissolves a
 *   glyph field column by column into the sharp photo. Afterwards the
 *   canvas is cleared and unregistered from the ticker — zero idle cost.
 * - Hover/tap re-encodes briefly (≤1s pulse), then back to the photo.
 * - Colors come from CSS custom properties and are read per frame, so a
 *   theme switch mid-animation just works.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../../styles/components/matrix-portrait.css';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
}

const { src, alt, caption, class: className = '' } = Astro.props;

// Matches .dpn-portrait's CSS max-width/aspect-ratio (420×525, 4:5) — the
// frame is fluid but never renders larger, so 1x/2x density covers every
// real display without generating unused wider variants.
const LAYOUT_WIDTH = 420;
const LAYOUT_HEIGHT = 525;
---

<figure class={['dpn-portrait', className].filter(Boolean).join(' ')} data-matrix-portrait>
  <div class="dpn-portrait__frame">
    <Image
      src={src}
      alt={alt}
      width={LAYOUT_WIDTH}
      height={LAYOUT_HEIGHT}
      densities={[1, 2]}
      format="webp"
      loading="eager"
    />
    <canvas data-matrix-portrait-canvas aria-hidden="true"></canvas>
  </div>
  {caption && <figcaption class="dpn-portrait__caption">{caption}</figcaption>}
</figure>

<script>
  import '../../scripts/matrix-portrait';
</script>
