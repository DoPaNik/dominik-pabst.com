---
interface Props {
  alt: string;
  image?: string;
  align?: 'center' | 'left';
  parallax?: boolean;
  class?: string;
}

const { alt, image = '/images/dominik-luma.png', align = 'center', parallax = false, class: className = '' } = Astro.props;
const anchorXPercent = align === 'left' ? 30 : 50;
---

<div
  class={['dpn-matrix-portrait', className].filter(Boolean).join(' ')}
  data-matrix-portrait
  data-image={image}
  data-anchor-x={anchorXPercent}
  data-parallax={parallax ? 'true' : 'false'}
  role="img"
  aria-label={alt}
  style={`--dpn-matrix-anchor-x: ${anchorXPercent}%;`}
>
  <canvas class="dpn-matrix-portrait__canvas" data-matrix-portrait-canvas aria-hidden="true"></canvas>
  <noscript>
    <img src={image} alt={alt} class="dpn-matrix-portrait__fallback" />
  </noscript>
</div>

<style>
  .dpn-matrix-portrait {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
    mask-image: radial-gradient(70% 90% at var(--dpn-matrix-anchor-x) 50%, #000 60%, transparent 100%);
    -webkit-mask-image: radial-gradient(70% 90% at var(--dpn-matrix-anchor-x) 50%, #000 60%, transparent 100%);
  }
  .dpn-matrix-portrait__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .dpn-matrix-portrait__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--dpn-matrix-anchor-x) center;
    display: block;
  }
</style>

<script>
  const GLYPHS = '01ﾊﾏｲﾑｳｵﾗｷｹﾜｺｴﾈｾﾀﾈﾇﾓﾔﾝﾛﾍｦｱｸ'.split('');
  const FONT_FAMILY = "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace";
  const ROW_HEIGHT = 19;
  const COL_WIDTH = 19;

  function randomChar() {
    return GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
  }

  function clamp(value: number, min: number, max: number) {
    return Math.max(min, Math.min(max, value));
  }

  interface RainColumn {
    x: number;
    headY: number;
    speed: number;
    trailSteps: number;
    chars: string[];
  }

  interface StreakParticle {
    angle: number;
    radius: number;
    maxRadius: number;
    speed: number;
  }

  interface FaceGrid {
    x0: number;
    y0: number;
    cellW: number;
    cellH: number;
    cols: number;
    rows: number;
    brightness: Float32Array;
    alpha: Float32Array;
    active: Uint8Array;
    chars: string[];
  }

  function makeColumn(x: number, height: number, seedAcrossView = false): RainColumn {
    const trailSteps = 12 + Math.floor(Math.random() * 14);
    const headY = seedAcrossView
      ? Math.random() * (height + trailSteps * ROW_HEIGHT) - trailSteps * ROW_HEIGHT
      : -Math.random() * 140;
    return {
      x,
      headY,
      speed: 90 + Math.random() * 160,
      trailSteps,
      chars: Array.from({ length: trailSteps }, randomChar),
    };
  }

  function makeStreak(maxRadius: number): StreakParticle {
    return {
      angle: Math.random() * Math.PI * 2,
      radius: Math.random() * maxRadius,
      maxRadius,
      speed: 1.2 + Math.random() * 2.4,
    };
  }

  function setupMatrixPortrait(root: HTMLElement) {
    if (root.dataset.matrixPortraitDone) return;
    root.dataset.matrixPortraitDone = 'true';

    const canvas = root.querySelector<HTMLCanvasElement>('[data-matrix-portrait-canvas]');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const anchorXFraction = Number(root.dataset.anchorX || '50') / 100;
    const parallaxEnabled = root.dataset.parallax === 'true';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const luma = new Image();
    luma.src = root.dataset.image || '/images/dominik-luma.png';

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let columns: RainColumn[] = [];
    let streaks: StreakParticle[] = [];
    let faceGrid: FaceGrid | null = null;
    let rafId = 0;
    let running = false;
    let lastTime = 0;

    function buildFaceData() {
      if (!luma.complete || luma.naturalWidth === 0) {
        faceGrid = null;
        return;
      }
      const drawH = height * 0.94;
      const drawW = drawH * (luma.naturalWidth / luma.naturalHeight);
      const dx = width * anchorXFraction - drawW / 2;
      const dy = height / 2 - drawH / 2;

      // Finer than the rain grid so facial features (eyes, nose, mouth) stay legible.
      const cellSize = COL_WIDTH / 2;
      const cols = Math.max(1, Math.round(drawW / cellSize));
      const rows = Math.max(1, Math.round(drawH / cellSize));

      const offCanvas = document.createElement('canvas');
      offCanvas.width = cols;
      offCanvas.height = rows;
      const offCtx = offCanvas.getContext('2d');
      if (!offCtx) {
        faceGrid = null;
        return;
      }
      offCtx.imageSmoothingEnabled = true;
      offCtx.drawImage(luma, 0, 0, cols, rows);
      const data = offCtx.getImageData(0, 0, cols, rows).data;

      const brightness = new Float32Array(cols * rows);
      const alphaArr = new Float32Array(cols * rows);
      const active = new Uint8Array(cols * rows);
      const chars = Array.from({ length: cols * rows }, randomChar);

      for (let i = 0; i < cols * rows; i++) {
        const o = i * 4;
        const t = data[o] / 255;
        const a = data[o + 3] / 255;
        brightness[i] = t;
        alphaArr[i] = a;
        active[i] = Math.random() < a * (0.6 + 0.4 * t) ? 1 : 0;
      }

      faceGrid = {
        x0: dx,
        y0: dy,
        cellW: drawW / cols,
        cellH: drawH / rows,
        cols,
        rows,
        brightness,
        alpha: alphaArr,
        active,
        chars,
      };
    }

    function resize() {
      const rect = root.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas!.width = Math.max(1, Math.round(width * dpr));
      canvas!.height = Math.max(1, Math.round(height * dpr));
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const colCount = Math.max(20, Math.min(140, Math.round(width / COL_WIDTH)));
      columns = Array.from({ length: colCount }, (_, i) => makeColumn(i * COL_WIDTH + COL_WIDTH / 2, height, true));

      const streakCount = Math.max(20, Math.min(70, Math.round((width * height) / 9000)));
      const maxRadius = Math.hypot(width, height) / 2 + 30;
      streaks = Array.from({ length: streakCount }, () => makeStreak(maxRadius));

      buildFaceData();
    }

    function parallaxOffset(): number {
      if (!parallaxEnabled || reduceMotion) return 0;
      const rect = root.getBoundingClientRect();
      const heroCenter = rect.top + rect.height / 2;
      const viewportCenter = window.innerHeight / 2;
      return clamp((viewportCenter - heroCenter) * 0.12, -48, 48);
    }

    function drawFaceGlyphs(offsetY: number) {
      if (!faceGrid) return;
      const { x0, y0, cellW, cellH, cols, rows, brightness, alpha, active, chars } = faceGrid;

      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'middle';
      ctx!.font = `${(cellH * 0.95).toFixed(1)}px ${FONT_FAMILY}`;

      for (let row = 0; row < rows; row++) {
        const y = y0 + (row + 0.5) * cellH + offsetY;
        if (y < -cellH || y > height + cellH) continue;
        for (let col = 0; col < cols; col++) {
          const i = row * cols + col;
          if (!active[i]) continue;
          const a = alpha[i];
          if (a < 0.12) continue;

          if (Math.random() < 0.015) chars[i] = randomChar();
          const t = brightness[i];
          const x = x0 + (col + 0.5) * cellW;
          const rC = Math.round(27 + (201 - 27) * t);
          const gC = Math.round(139 + (251 - 139) * t);
          const bC = Math.round(76 + (224 - 76) * t);
          ctx!.fillStyle = `rgba(${rC}, ${gC}, ${bC}, ${Math.min(1, a * (0.55 + 0.45 * t))})`;
          ctx!.fillText(chars[i], x, y);
        }
      }
    }

    function drawRain(dtMs: number) {
      ctx!.textAlign = 'center';
      ctx!.textBaseline = 'middle';

      for (const col of columns) {
        for (let i = 0; i < col.trailSteps; i++) {
          const y = col.headY - i * ROW_HEIGHT;
          if (y < -ROW_HEIGHT || y > height + ROW_HEIGHT) continue;
          const t = 1 - i / col.trailSteps;
          const alpha = i === 0 ? 1 : t * t * 0.85;
          ctx!.font = `${(ROW_HEIGHT * 0.82).toFixed(1)}px ${FONT_FAMILY}`;
          ctx!.globalAlpha = alpha;
          ctx!.fillStyle = i === 0 ? '#C9FBE0' : i < 3 ? '#5FE39B' : '#1B8B4C';
          if (Math.random() < 0.03) col.chars[i] = randomChar();
          ctx!.fillText(col.chars[i], col.x, y);
        }

        col.headY += (col.speed * dtMs) / 1000;
        if (col.headY - col.trailSteps * ROW_HEIGHT > height) {
          const fresh = makeColumn(col.x, height);
          col.headY = fresh.headY;
          col.speed = fresh.speed;
          col.trailSteps = fresh.trailSteps;
          col.chars = fresh.chars;
        }
      }
      ctx!.globalAlpha = 1;
    }

    function drawStreaks(cx: number, cy: number, dtMs: number) {
      for (const s of streaks) {
        const t = s.radius / s.maxRadius;
        const fade = t < 0.06 ? t / 0.06 : t > 0.8 ? Math.max(0, (1 - t) / 0.2) : 1;
        const len = 8 + t * 46;
        const x1 = cx + Math.cos(s.angle) * s.radius;
        const y1 = cy + Math.sin(s.angle) * s.radius;
        const x2 = cx + Math.cos(s.angle) * (s.radius - len);
        const y2 = cy + Math.sin(s.angle) * (s.radius - len);

        ctx!.strokeStyle = '#37D67A';
        ctx!.globalAlpha = fade * (0.12 + t * 0.22);
        ctx!.lineWidth = 1;
        ctx!.beginPath();
        ctx!.moveTo(x1, y1);
        ctx!.lineTo(x2, y2);
        ctx!.stroke();

        s.radius += s.speed * (1 + t * 3) * (dtMs / 16.7);
        if (s.radius > s.maxRadius) {
          s.radius = Math.random() * s.maxRadius * 0.05;
          s.angle = Math.random() * Math.PI * 2;
        }
      }
      ctx!.globalAlpha = 1;
    }

    function drawFrame(now: number) {
      const dtMs = lastTime ? Math.min(now - lastTime, 50) : 16.7;
      lastTime = now;
      const offset = parallaxOffset();

      ctx!.fillStyle = '#000';
      ctx!.fillRect(0, 0, width, height);

      drawStreaks(width * anchorXFraction, height / 2 + offset, dtMs);
      drawRain(dtMs);
      drawFaceGlyphs(offset);
    }

    function loop(now: number) {
      if (!running) return;
      drawFrame(now);
      rafId = requestAnimationFrame(loop);
    }

    function start() {
      if (running) return;
      running = true;
      lastTime = 0;
      rafId = requestAnimationFrame(loop);
    }

    function stop() {
      running = false;
      if (rafId) cancelAnimationFrame(rafId);
    }

    function drawStaticFrame() {
      ctx!.fillStyle = '#000';
      ctx!.fillRect(0, 0, width, height);
      drawRain(0);
      drawFaceGlyphs(parallaxOffset());
    }

    const ready = () => {
      if (!root.isConnected) return;
      resize();
      if (width === 0 || height === 0) {
        requestAnimationFrame(ready);
        return;
      }
      if (reduceMotion) {
        drawStaticFrame();
        return;
      }
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) start();
            else stop();
          }
        },
        { threshold: 0.05 },
      );
      observer.observe(root);
    };

    if (luma.complete) ready();
    else luma.addEventListener('load', ready, { once: true });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      if (!root.isConnected) return;
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (reduceMotion) drawStaticFrame();
      }, 150);
    });
  }

  function initMatrixPortraits() {
    document
      .querySelectorAll<HTMLElement>('[data-matrix-portrait]')
      .forEach((root) => setupMatrixPortrait(root));
  }

  initMatrixPortraits();
  document.addEventListener('astro:page-load', initMatrixPortraits);
</script>
