---
interface Props {
  tone?: 'brand' | 'amber' | 'blue' | 'magenta' | 'cyan' | 'danger' | 'neutral';
  variant?: 'soft' | 'solid' | 'outline';
  dot?: boolean;
  class?: string;
}

const { tone = 'brand', variant = 'soft', dot = false, class: className = '' } = Astro.props;
const cls = ['dpn-badge', `dpn-badge--${variant}`, `dpn-badge--tone-${tone}`, className]
  .filter(Boolean)
  .join(' ');
---

<span class={cls}>
  {dot && <span class="dpn-badge__dot" />}
  <slot />
</span>
