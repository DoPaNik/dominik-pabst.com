---
interface Props {
  title?: string;
  plain?: boolean;
  class?: string;
}

const { title = '~/dopanik — zsh', plain = false, class: className = '' } = Astro.props;
const cls = ['dpn-term', plain ? 'dpn-term--plain' : '', className].filter(Boolean).join(' ');
const hasRight = Astro.slots.has('right');
---

<div class={cls}>
  <div class="dpn-term__bar">
    <span class="dpn-term__lights">
      <span class="dpn-term__light dpn-term__light--danger"></span>
      <span class="dpn-term__light dpn-term__light--warning"></span>
      <span class="dpn-term__light dpn-term__light--success"></span>
    </span>
    <span class="dpn-term__title">{title}</span>
    {
      hasRight && (
        <span class="dpn-term__chrome-right">
          <slot name="right" />
        </span>
      )
    }
  </div>
  <div class="dpn-term__body">
    <slot />
  </div>
</div>
