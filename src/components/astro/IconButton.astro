---
interface Props {
  variant?: 'default' | 'solid' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  label: string;
  href?: string;
  class?: string;
}

const { variant = 'default', size = 'md', label, href, class: className = '' } = Astro.props;

const cls = [
  'dpn-iconbtn',
  variant !== 'default' ? `dpn-iconbtn--${variant}` : '',
  size !== 'md' ? `dpn-iconbtn--${size}` : '',
  className,
]
  .filter(Boolean)
  .join(' ');

const Tag = href ? 'a' : 'button';
---

<Tag class={cls} href={href} type={href ? undefined : 'button'} aria-label={label} title={label}>
  <slot />
</Tag>
